{
  "name": "nora-framework-browser-tests",
  "private": true,
  "scripts": {
    "assets:dev": "tailwindcss -i resources/css/app.css -o examples/nora-tailwind-dashboard/public/assets/app.css --watch",
    "assets:build": "tailwindcss -i resources/css/app.css -o examples/nora-tailwind-dashboard/public/assets/app.css --minify",
    "pretest:browser": "npm run assets:build",
    "test:browser": "node --test tests/browser/reactive.test.js tests/browser/tailwind-dashboard.test.js",
    "test:tailwind": "npm run assets:build && node --test tests/tailwind.test.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0"
  }
}
